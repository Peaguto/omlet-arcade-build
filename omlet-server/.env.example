# Omlet Arcade Custom Server Configuration
# Copy this file to .env and modify values

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# API Authentication (match these with GitHub Secrets!)
API_KEY=omlet-local-key-2024
API_SECRET=omlet-local-secret-2024

# Media Storage
MEDIA_DIR=./media

# MediaMTX (RTMP/HLS server)
MEDIAMTX_PATH=mediamtx

# Optional: Database (for production)
# DATABASE_URL=postgresql://user:pass@localhost/omlet

# Optional: Redis (for scaling)
# REDIS_URL=redis://localhost:6379