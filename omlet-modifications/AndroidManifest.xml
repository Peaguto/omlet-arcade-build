<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="mobisocial.arcade"
    android:versionCode="100458"
    android:versionName="1.111.9-mod"
    android:compileSdkVersion="31"
    android:compileSdkVersionCodename="12"
    platformBuildVersionCode="31"
    platformBuildVersionName="12">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="31" />

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <uses-permission android:name="com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE" />

    <!-- Features -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name="mobisocial.arcade.ArcadeApplication"
        android:allowBackup="true"
        android:backupAgent="mobisocial.omlib.ui.signin.OmletBackupAgent"
        android:debuggable="true"
        android:extractNativeLibs="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/omp_ic_arcade"
        android:label="@string/oma_arcade_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:restoreAnyVersion="true"
        android:roundIcon="@mipmap/omp_ic_arcade_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:usesCleartextTraffic="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory">

        <!-- Meta-data for configuration -->
        <meta-data android:name="host" android:value="YOUR_SERVER_DOMAIN_HERE" />
        <meta-data android:name="arcadeHostName" android:value="YOUR_SERVER_DOMAIN_HERE" />
        <meta-data android:name="omlet.server" android:value="https://YOUR_SERVER_DOMAIN_HERE" />
        <meta-data android:name="omlet.apikey" android:value="YOUR_API_KEY" />
        <meta-data android:name="omlet.secret" android:value="YOUR_API_SECRET" />
        <meta-data android:name="omlet.chat" android:value="true" />
        <meta-data android:name="omlet.arcade.back" android:value="false" />
        <meta-data android:name="com.google.android.gms.version" android:value="@integer/google_play_services_version" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/oma_ic_white_stream_omlet" />
        <meta-data android:name="com.huawei.hms.client.appid" android:value="104581700" />

        <!-- Providers -->
        <provider
            android:name="mobisocial.arcade.AGCInitializeProvider"
            android:authorities="mobisocial.arcade.agcinitializeprovider"
            android:exported="false"
            android:initOrder="100" />
        <provider
            android:name="mobisocial.arcade.AudienceNetworkContentProvider"
            android:authorities="mobisocial.arcade.audience-network-content-provider"
            android:exported="false" />
        <provider
            android:name="mobisocial.arcade.DirectShareContentProvider"
            android:authorities="mobisocial.arcade.direct-share-content-provider"
            android:exported="true" />
        <provider
            android:name="mobisocial.arcade.FacebookInitProvider"
            android:authorities="mobisocial.arcade.facebook-init-provider"
            android:exported="false" />
        <provider
            android:name="mobisocial.arcade.aaidinitprovider"
            android:authorities="mobisocial.arcade.aaidinitprovider"
            android:exported="false" />
        <provider
            android:name="mobisocial.omlib.ui.signin.OmletBackupAgent"
            android:authorities="mobisocial.arcade.backup-agent"
            android:exported="false" />

        <!-- Main Activities -->
        <!-- Config Server Activity - Shows on first launch to configure server -->
        <activity
            android:name="mobisocial.arcade.ConfigServerActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="mobisocial.arcade.sdk.activity.ArcadeActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:launchMode="singleTask"
            android:theme="@style/ArcadeTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="android.support.PARENT_ACTIVITY" android:value="mobisocial.arcade.sdk.activity.ArcadeActivity" />
        </activity>

        <activity
            android:name="mobisocial.arcade.sdk.activity.ArcadeSignInActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="true"
            android:theme="@style/ArcadeTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:host="YOUR_SERVER_DOMAIN_HERE" android:scheme="https" />
                <data android:host="arcade.YOUR_SERVER_DOMAIN_HERE" android:scheme="https" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:host="YOUR_SERVER_DOMAIN_HERE" android:scheme="omletarcade" />
                <data android:host="arcade.YOUR_SERVER_DOMAIN_HERE" android:scheme="omletarcade" />
            </intent-filter>
        </activity>

        <activity
            android:name="mobisocial.arcade.sdk.activity.DeepLinkParserActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/ArcadeTheme.Transparent.DarkStatusBar.BackgroundDim">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:host="YOUR_SERVER_DOMAIN_HERE" android:scheme="https" />
                <data android:host="arcade.YOUR_SERVER_DOMAIN_HERE" android:scheme="https" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:host="YOUR_SERVER_DOMAIN_HERE" android:scheme="omletarcade" />
                <data android:host="arcade.YOUR_SERVER_DOMAIN_HERE" android:scheme="omletarcade" />
            </intent-filter>
        </activity>

        <!-- Other key activities -->
        <activity
            android:name="mobisocial.arcade.engineer.EngineerModeActivity"
            android:exported="false"
            android:theme="@style/ArcadeTheme.NoActionBar" />

        <!-- Services -->
        <service
            android:name="mobisocial.omlib.service.gcm.FirebaseListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <service
            android:name="mobisocial.omlib.service.gcm.FirebaseInstanceIdService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.INSTANCE_ID_EVENT" />
            </intent-filter>
        </service>

        <service
            android:name="mobisocial.arcade.sdk.util.GameDetectorService"
            android:exported="false" />
        <service
            android:name="mobisocial.arcade.sdk.util.KeepAliveService"
            android:exported="false" />
        <service
            android:name="mobisocial.omlet.streaming.OmMediaProjectionManager$MediaProjectionService"
            android:exported="false"
            android:permission="android.permission.BIND_MEDIA_PROJECTION" />

        <!-- Receivers -->
        <receiver
            android:name="mobisocial.arcade.PackageReceivers$MyPackageReceiver"
            android:exported="true"
            android:permission="android.permission.INSTALL_PACKAGES">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="mobisocial.arcade.PackageReceivers$PackageReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="mobisocial.arcade.InstallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.vending.INSTALL_REFERRER" />
            </intent-filter>
        </receiver>

    </application>

    <!-- Queries for package visibility -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <package android:name="com.android.chrome" />
        <package android:name="com.google.android.youtube" />
    </queries>

</manifest>